# =====================================================================
# AI-English - Mau cau hinh moi truong
#
# Cach dung:
#     1. Sao chep file nay thanh `.env`
#     2. Dien gia tri that
#     3. KHONG commit `.env` (da nam trong .gitignore)
#
# Moi bien deu KHONG bat buoc tru nhom DATABASE. Bo trong thi he thong dung
# gia tri mac dinh trong `config/schema.py`.
# =====================================================================


# ---------------------------------------------------------------------
# MOI TRUONG CHAY
# ---------------------------------------------------------------------
# development | testing | production
# Mac dinh: development
AI_ENGLISH_ENV=development


# ---------------------------------------------------------------------
# CO SO DU LIEU (BAT BUOC)
# ---------------------------------------------------------------------
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password

# Kich thuoc connection pool (Sprint 4)
# Mac dinh: 1 / 8
DB_POOL_MIN=1
DB_POOL_MAX=8


# ---------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------
# CANH BAO: doi cac gia tri nay se doi KET QUA nhan dien.
# Chi doi khi ban that su hieu anh huong.

# Nguong confidence toi thieu cua YOLO, trong khoang (0, 1]
# Mac dinh: 0.5
AI_CONFIDENCE=0.5

# Kich thuoc anh dau vao YOLO, phai la boi so cua 32
# Mac dinh: 640
AI_IMAGE_SIZE=640

# Ten file model trong thu muc models/
# Mac dinh: best.pt
AI_MODEL_FILE=best.pt

# So tu lien quan lay tu k-NN
# Mac dinh: 3
AI_RELATED_WORDS=3


# ---------------------------------------------------------------------
# WEBCAM
# ---------------------------------------------------------------------
# Chi so thiet bi camera
# Mac dinh: 0
CAMERA_ID=0

# Nhip chay AI tren luong webcam (giay). Nho hon = muot hon nhung ton CPU hon.
# Mac dinh: 0.25
CAMERA_INFERENCE_INTERVAL=0.25

# So frame toi da duoc phep "dang bay" giua worker va giao dien (Sprint 5).
# Tang len neu may manh, giam xuong neu giao dien bi tre.
# Mac dinh: 2
CAMERA_MAX_FRAMES_IN_FLIGHT=2


# ---------------------------------------------------------------------
# LICH SU NHAN DIEN
# ---------------------------------------------------------------------
# Khoang cach toi thieu giua 2 lan luu cung mot tu (giay)
# Mac dinh: 5.0
HISTORY_COOLDOWN_SECONDS=5.0

# So ban ghi hien tren man hinh lich su (toi da 500)
# Mac dinh: 200
HISTORY_PAGE_LIMIT=200

# So ban ghi dung de tinh thong ke (toi da 500)
# Mac dinh: 500
HISTORY_STATS_LIMIT=500

# Kich thuoc hang doi ghi lich su cua webcam
# Mac dinh: 20
HISTORY_WRITE_QUEUE_SIZE=20


# ---------------------------------------------------------------------
# LUONG NEN (Sprint 5)
# ---------------------------------------------------------------------
# Thoi gian cho toi da khi dung mot worker (mili giay)
# Mac dinh: 3000
THREAD_DISPOSE_TIMEOUT_MS=3000

# Chu ky kiem tra co huy khi hang doi trong (giay)
# Mac dinh: 0.1
THREAD_POLL_INTERVAL=0.1


# ---------------------------------------------------------------------
# GHI LOG
# ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# Mac dinh theo moi truong: development=INFO, testing=ERROR, production=WARNING
LOG_LEVEL=INFO

# Bat do hieu nang chi tiet (utils/perf_monitor.py): 1 de bat
# Mac dinh: 0
AI_ENGLISH_PERF=0
